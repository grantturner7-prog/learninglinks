# Copy to ".env" in the repository root on the server and fill in every line. Never commit the real file.

# ---- Where the site lives ----
# The address people type, without https://. DNS must already point at this server.
DOMAIN=learninglinks.example
# The same address with https:// (used in emails and sign-in callbacks).
NEXT_PUBLIC_APP_URL=https://learninglinks.example

# ---- Secrets (generate each one yourself) ----
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -base64 24   (letters and numbers only is easiest)
POSTGRES_PASSWORD=
# openssl rand -base64 32   (the reminders job uses it to call the site)
CRON_SECRET=

# ---- People ----
# Comma-separated emails that may use /admin. They must be VERIFIED accounts.
ADMIN_EMAILS=
# Public address for appeals, privacy requests and reports (shown on the legal pages).
SUPPORT_EMAIL=

# ---- Email (required in production) ----
RESEND_API_KEY=
EMAIL_FROM=LearningLinks <no-reply@learninglinks.example>

# ---- Payments: bank transfer details shown on the order page ----
BANK_NAME=
BANK_BRANCH=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=

# ---- Behaviour ----
# Distinct educators one campus or family may open per day (Taipei time).
REVEAL_DAILY_CAP=100
# Days of nightly backups to keep in ./backups.
BACKUP_KEEP_DAYS=14
# Set to true ONLY after your lawyer has approved the Terms, Privacy Policy and Educator Waiver.
LEGAL_REVIEWED=false
