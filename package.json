{
  "name": "learninglinks",
  "version": "0.1.0",
  "private": true,
  "description": "LearningLinks: education-only directory connecting educators with schools and families across Asia.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "geo:build": "tsx scripts/build-geo.ts",
    "sync:map-worker": "node scripts/sync-map-worker.mjs",
    "predev": "node scripts/sync-map-worker.mjs",
    "prebuild": "node scripts/sync-map-worker.mjs",
    "db:import-cram": "tsx --env-file-if-exists=.env.local scripts/import-cram-schools.ts",
    "db:import-moe": "tsx --env-file-if-exists=.env.local scripts/import-moe-schools.ts",
    "db:import-schools": "tsx --env-file-if-exists=.env.local scripts/import-schools.ts",
    "db:seed-demo": "tsx --env-file-if-exists=.env.local scripts/seed-demo.ts",
    "db:demo-accounts": "tsx --env-file-if-exists=.env.local scripts/demo-accounts.ts",
    "preflight": "tsx --env-file-if-exists=.env.local scripts/preflight.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "maplibre-gl": "^6.18.0",
    "next": "^16.4.6",
    "next-intl": "^4.15.1",
    "pg": "^8.23.1",
    "polylabel": "^2.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "supercluster": "^9.1.0",
    "taiwan-atlas": "^2021.9.20",
    "topojson-client": "^3.1.0",
    "topojson-simplify": "^3.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/polylabel": "^2.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supercluster": "^7.1.3",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-simplify": "^3.0.3",
    "@types/topojson-specification": "^1.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
