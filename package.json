{
  "name": "learninglinks",
  "version": "0.1.0",
  "private": true,
  "description": "LearningLinks: education-only directory connecting educators with schools and families across Asia.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
