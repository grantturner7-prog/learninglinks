# ---- Core ----
# Public base URL of the app (used for auth callbacks and sitemap).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Postgres connection string.
DATABASE_URL=postgres://learninglinks:learninglinks@localhost:5432/learninglinks
# 32+ random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me

# ---- Access control ----
# Comma-separated emails that get admin rights. Must be a VERIFIED email address.
ADMIN_EMAILS=
# true in production. When false, accounts can sign in without verifying email (dev only).
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# ---- Email (transactional). Without a key, emails are printed to the server log. ----
RESEND_API_KEY=
EMAIL_FROM=LearningLinks <no-reply@example.com>

# ---- Uploads (profile photos). Local disk in dev; swap for object storage in production. ----
UPLOAD_DIR=.data/uploads

# ---- Abuse protection ----
# Max distinct educators a member organisation may reveal contact details for, per day (Taipei time).
REVEAL_DAILY_CAP=100

# ---- Payments: online with ECPay (綠界). Leave all three empty to keep online payment switched OFF. ----
# Your own keys come from the ECPay merchant back office after they approve your shop.
# To try the flow with no real money, use ECPay's PUBLIC TEST account (published in their developer documentation):
#   ECPAY_MERCHANT_ID=3002607   ECPAY_HASH_KEY=pwFHCqoQZGmho4w6   ECPAY_HASH_IV=EkRm7iFT261dpevs   ECPAY_MODE=stage
# Never use the test account on a live site (the launch check refuses it).
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# "stage" = ECPay's test server (default); "production" = real money.
ECPAY_MODE=stage
# Which methods to offer: Credit, ATM (virtual account), CVS (convenience-store code). The buyer picks one on the order page.
ECPAY_METHODS=Credit,ATM,CVS

# ---- Payments: manual bank transfer. Optional once ECPay is on; leave empty until you have an account to show. ----
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=

# ---- Legal ----
# Set to true only after a lawyer has approved the Terms, Privacy Policy and Educator Waiver.
LEGAL_REVIEWED=false
# Public support address shown in the "Contact and reports" block of the Terms, Privacy policy and Educator waiver.
# A plain address such as help@example.com. If left empty, those pages say a contact address will be published at launch.
SUPPORT_EMAIL=
# Optional discount (percent off list). Prices are flat by default: leave at 0.
FOUNDING_DISCOUNT_PERCENT=0

# ---- Tests (optional): a separate database for the DB integration tests. They are skipped without it. ----
TEST_DATABASE_URL=

# Scheduled jobs: renewal reminders. POST /api/cron/reminders daily with "Authorization: Bearer <this value>" (24+ characters).
CRON_SECRET=
